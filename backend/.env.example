NODE_ENV=development
PORT=3002
# Local MongoDB, or use Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/royaldsa?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/royaldsa
MONGODB_DB_NAME=royaldsa
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
REDIS_URL=redis://localhost:6379
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION_SEC=60


JUDGE0_BASE_URL=http://localhost:2358

JUDGE0_API_KEY=
JUDGE0_API_HOST=

JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLLS=25


GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GEMINI_FALLBACK_MODELS=gemini-2.0-flash


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/v1/auth/oauth/google/callback

FRONTEND_OAUTH_SUCCESS_URL=http://localhost:8080/oauth/callback
